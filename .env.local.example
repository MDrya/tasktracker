# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google Sheets sync (optional — the app runs fine without these).
# See the "Sync to Google Sheets" section of the README.
# The URL comes from deploying google-apps-script.gs as a web app; the
# secret is any random string, and must match SHARED_SECRET in that script.
GOOGLE_SHEETS_WEBAPP_URL=
SHEETS_SHARED_SECRET=
