# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google Sheets sync (optional — the app runs fine without these).
# See the "Sync to Google Sheets" section of the README.
# The URL comes from deploying google-apps-script.gs as a web app; the
# secret is any random string, and must match SHARED_SECRET in that script.
GOOGLE_SHEETS_WEBAPP_URL=
SHEETS_SHARED_SECRET=

# Due-date push notifications (optional — the in-app warning banner works
# without these; only the daily phone notification needs them).
# Generate your own keypair, free and with no external account, using:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Any random string. Stops anyone but Vercel Cron from triggering the
# daily digest. Generate with: openssl rand -hex 32
CRON_SECRET=
